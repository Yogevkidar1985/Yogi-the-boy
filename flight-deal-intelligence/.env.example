# Flight Deal Intelligence — environment configuration (§58)
# No API key is required for the default providers (§59):
# fast-flights and fli talk to Google Flights directly.

# --- core ---
PORT=3010
DATABASE_PATH=data/flight-intel.db
DEFAULT_CURRENCY=ILS
DEFAULT_ORIGIN=TLV

# --- providers ---
# Mock provider: for demos/tests only. NEVER enable in production searches.
MOCK_PROVIDER=0
ALLOW_MOCK_FALLBACK=0
PYTHON_BIN=python3
FLI_BIN=fli
# Optional enrichment (system works without it — §6):
FLIGHTRADAR_API_KEY=
# Additional independent sources (recommended for cloud deployments where
# Google may throttle datacenter IPs). All searched IN PARALLEL when set:
# SerpAPI — free tier at https://serpapi.com (Google Flights results)
SERPAPI_API_KEY=
# Amadeus Self-Service — free tier at https://developers.amadeus.com (GDS data)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# set to "production" after upgrading your Amadeus app (default: test env)
AMADEUS_ENV=
# Duffel — airline offers (NDC/GDS/LCC), token from https://duffel.com
DUFFEL_API_TOKEN=
# Kiwi.com Tequila — virtual interlining / unconventional routes,
# key from https://tequila.kiwi.com (self-transfer results are risk-flagged)
KIWI_API_KEY=

# --- meta-search orchestration (V4) ---
# per-provider hard timeout default (seconds); adapters may declare tighter ones
PROVIDER_TIMEOUT_SECONDS=45
# circuit breaker: consecutive failures before a provider is paused + cooldown
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_MINUTES=5
# daily budget of paid-provider requests (protects API quotas; free sources
# keep searching when spent, verification may still use paid sources)
PAID_REQUESTS_PER_DAY=400
# identical-search cache: fresh TTL + stale-while-revalidate horizon (minutes)
SEARCH_CACHE_MINUTES=10
SEARCH_STALE_MINUTES=45

# --- worker / monitoring (§27-§28) ---
WORKER_POLL_SECONDS=60
MAX_QUERIES_PER_REQUEST=24
SEARCH_CONCURRENCY=4
# Price history retention (days). Empty/0 = keep forever (§72).
PRICE_RETENTION_DAYS=

# --- alerts (§26) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
EMAIL_PROVIDER=

# --- integrations ---
CLAUDE_CODE_ENABLED=1
FLIGHT_FINDER_URL=http://localhost:3003
