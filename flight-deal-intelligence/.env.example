# Flight Deal Intelligence — environment configuration (§58)
# No API key is required for the default providers (§59):
# fast-flights and fli talk to Google Flights directly.

# --- core ---
PORT=3010
DATABASE_PATH=data/flight-intel.db
DEFAULT_CURRENCY=ILS
DEFAULT_ORIGIN=TLV

# --- providers ---
# Mock provider: for demos/tests only. NEVER enable in production searches.
MOCK_PROVIDER=0
ALLOW_MOCK_FALLBACK=0
PYTHON_BIN=python3
FLI_BIN=fli
# Optional enrichment (system works without it — §6):
FLIGHTRADAR_API_KEY=
# Additional independent sources (recommended for cloud deployments where
# Google may throttle datacenter IPs). All searched IN PARALLEL when set:
# SerpAPI — free tier at https://serpapi.com (Google Flights results)
SERPAPI_API_KEY=
# Amadeus Self-Service — free tier at https://developers.amadeus.com (GDS data)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# set to "production" after upgrading your Amadeus app (default: test env)
AMADEUS_ENV=
# Duffel — airline offers (NDC/GDS/LCC), token from https://duffel.com
DUFFEL_API_TOKEN=
# Kiwi.com Tequila — invite-only B2B since 2024 (adapter ready for a partner key)
KIWI_API_KEY=

# Travelpayouts / Aviasales Flight Data API — free self-serve registration at
# https://www.travelpayouts.com. Returns CACHED cheapest-fare observations
# (not a live availability search), so results are marked as cached.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- custom providers: connect ANY JSON flight API without writing code ------
# Up to three slots: CUSTOM1_, CUSTOM2_, CUSTOM3_.
# Placeholders available in the URL and in header values:
#   {KEY} {origin} {destination} {departureDate} {returnDate}
#   {adults} {children} {infants} {currency}
#   {cabin}=ECONOMY  {cabinTitle}=Economy  {cabinLower}=economy
# CUSTOM1_NAME=flightapi
# CUSTOM1_URL=https://api.example.com/search?key={KEY}&from={origin}&to={destination}&date={departureDate}
# CUSTOM1_KEY=your-api-key
# CUSTOM1_HEADERS={"Authorization":"Bearer {KEY}"}
# CUSTOM1_ITEMS=data.itineraries          # JSON path to the results array
# CUSTOM1_MAP={"price":"fare.total","currency":"fare.currency","airline":"carrier.iata","flightNumber":"carrier.number","departureTime":"dep","arrivalTime":"arr","stops":"stopCount","durationMinutes":"durationMin","bookingUrl":"link"}
# CUSTOM1_TIER=PAID
# CUSTOM1_TIMEOUT_MS=20000

# --- provider feature flags (all default ON; a provider still needs its
#     credentials before it actually runs). Set to false to disable at runtime.
ENABLE_FAST_FLIGHTS=true
ENABLE_FLI=true
ENABLE_SERPAPI=true
ENABLE_AMADEUS=true
ENABLE_DUFFEL=true
ENABLE_KIWI=true
ENABLE_MOCK=true

# --- per-provider limits (requests/minute + max concurrent requests) ---
# AMADEUS_RPM=40
# AMADEUS_CONCURRENCY=5
# DUFFEL_RPM=40
# DUFFEL_CONCURRENCY=5
# KIWI_RPM=60
# SERPAPI_RPM=20
# FAST_FLIGHTS_RPM=30

# --- API rate limiting (per client IP, expensive endpoints only) ---
API_RATE_WINDOW_SECONDS=60
API_RATE_MAX_SEARCHES=40

# --- meta-search orchestration (V4) ---
# per-provider hard timeout default (seconds); adapters may declare tighter ones
PROVIDER_TIMEOUT_SECONDS=45
# circuit breaker: consecutive failures before a provider is paused + cooldown
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_MINUTES=5
# daily budget of paid-provider requests (protects API quotas; free sources
# keep searching when spent, verification may still use paid sources)
PAID_REQUESTS_PER_DAY=400
# identical-search cache: fresh TTL + stale-while-revalidate horizon (minutes)
SEARCH_CACHE_MINUTES=10
SEARCH_STALE_MINUTES=45

# --- worker / monitoring (§27-§28) ---
WORKER_POLL_SECONDS=60
MAX_QUERIES_PER_REQUEST=24
SEARCH_CONCURRENCY=4
# Price history retention (days). Empty/0 = keep forever (§72).
PRICE_RETENTION_DAYS=

# --- alerts (§26) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
EMAIL_PROVIDER=

# --- integrations ---
CLAUDE_CODE_ENABLED=1
FLIGHT_FINDER_URL=http://localhost:3003

# --- admin console for adding search engines from the UI ---------------------
# ADMIN_TOKEN: the password for /admin.html (required to open the console)
# ADMIN_SECRET: 20+ chars, encrypts stored API keys (AES-256-GCM).
# Without ADMIN_SECRET the system refuses to persist API keys at all.
ADMIN_TOKEN=
ADMIN_SECRET=
